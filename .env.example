# ── App ────────────────────────────────────────────────
APP_NAME=securewebproject
ENVIRONMENT=development            # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# ── Database (PostgreSQL) ──────────────────────────────
# 로컬 실행 시 localhost, docker-compose 실행 시 host를 'db'로.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/appdb

# ── Redis (Celery broker & result backend) ─────────────
# docker-compose 실행 시 host를 'redis'로.
REDIS_URL=redis://localhost:6379/0

# ── 알림 전송 (예시 — 실제 값은 .env에만) ──────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASSWORD=your-password
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ── 크롤링 ─────────────────────────────────────────────
CRAWL_USER_AGENT=securewebproject-bot/1.0
CRAWL_TIMEOUT_SECONDS=15
