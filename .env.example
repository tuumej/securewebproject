# ── App ────────────────────────────────────────────────
APP_NAME=securewebproject
ENVIRONMENT=development            # development | staging | production
DEBUG=true
# 진단(diagnosis) 기능에서 등록한 SSH 자격증명을 암호화하는 키도 이 값에서
# 유도된다. 운영 환경에서는 반드시 강력한 랜덤값으로 바꿀 것 — 기본값을 그대로
# 쓰면 자격증명 암호화가 무력화된다. 이 값을 회전(변경)하면 이미 등록된 진단
# 대상의 자격증명은 복호화할 수 없게 되어 대상을 다시 등록해야 한다.
SECRET_KEY=change-me-to-a-long-random-string

# ── Database (PostgreSQL) ──────────────────────────────
# 로컬 실행 시 localhost, docker-compose 실행 시 host를 'db'로.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/appdb

# ── Redis (Celery broker & result backend) ─────────────
# docker-compose 실행 시 host를 'redis'로.
REDIS_URL=redis://localhost:6379/0

# ── 알림 전송 (예시 — 실제 값은 .env에만) ──────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890   # 채널은 음수 ID, 개인은 양수 ID

# ── 크롤링 ─────────────────────────────────────────────
CRAWL_USER_AGENT=securewebproject-bot/1.0
CRAWL_TIMEOUT_SECONDS=15
